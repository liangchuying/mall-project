# RocketMQ 配置
ROCKETMQ_NAMESRV_PORT=9876
ROCKETMQ_BROKER_PORT=10909
ROCKETMQ_BROKER_HTTP_PORT=10911
ROCKETMQ_BROKER_ADMIN_PORT=10912
